# --- Server ---
PORT=5000
# Comma-separated list of exact frontend origins allowed by CORS (no trailing slash).
# Production example: https://entropysoft.com,https://www.entropysoft.com
FRONTEND_URL=http://localhost:5173
# Set to 1 when deployed behind a single reverse proxy (Render, Railway, Heroku...)
# so rate limiting sees the real visitor IP. Leave empty locally.
TRUST_PROXY=

# --- Email (Gmail SMTP with an App Password) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=entropysoft101@gmail.com
EMAIL_APP_PASSWORD=your_16_character_gmail_app_password
CONTACT_RECEIVER=entropysoft101@gmail.com
